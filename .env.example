# Copy to .env.development.local for development and account smoke commands.
# Copy to .env.production.local for release builds, using your production client.
# Existing shell environment variables take precedence. Restart commands after editing.

# VITE_ variables are shared build configuration for main and renderer.
# Read them with import.meta.env.VITE_<NAME>; new keys need no Vite config changes.
# Google Desktop OAuth client. Both modes use the same variable names.
# Client IDs have the form <client-id>.apps.googleusercontent.com.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# Optional, if supplied with the Desktop client configuration.
VITE_GOOGLE_DRIVE_CLIENT_SECRET=
